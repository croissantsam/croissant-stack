{
  "name": "croissant-stack",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "PORTLESS_LAN=1 turbo dev",
    "proxy:lan": "portless proxy start --lan",
    "lint": "oxlint --ignore-path .oxlintignore .",
    "lint:fix": "oxlint --fix --ignore-path .oxlintignore .",
    "format": "oxfmt --check --ignore-path .oxlintignore",
    "format:fix": "oxfmt --ignore-path .oxlintignore .",
    "quality": "turbo quality",
    "quality:fix": "turbo quality:fix",
    "typecheck": "turbo typecheck",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "update-deps": "pnpm dlx npm-check-updates -u -w --root && pnpm install",
    "prepare": "husky"
  },
  "dependencies": {
    "@orpc/client": "latest",
    "@orpc/server": "latest",
    "@orpc/tanstack-query": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "better-auth": "^1.6.11"
  },
  "devDependencies": {
    "@better-auth/core": "^1.6.11",
    "husky": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "portless": "latest",
    "turbo": "latest",
    "typescript": "6.0.3",
    "zod": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "better-sqlite3",
      "electron-winstaller",
      "electron",
      "esbuild",
      "msw",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.2"
}
